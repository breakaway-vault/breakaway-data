way.com/terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmS5XvYFnM4nm2fscKM9g2FW1RBKGGQ9iRjyxiavaSnEfr"}, "content-type": "image/png", "sha256": "V7Mk8pat5K0iWJzcYwFoUTweqIDzq8yp2j0F6xCHCmk=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmNRJ7owchNZxBgz7SDcUubfGE3QSf5nh3FoUvgtTz7ers"}, "content-type": "image/png", "height": 350, "sha256": "ZH-FcMeVftC3sRYaIu1drh4LzVSIKNdw-91p43Xu5Tw=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmQX9KTiNi53F9N6dA5uhciejabLc7FcG1pon3ZrRvNuuk"}, "content-type": "image/png", "height": 500, "sha256": "2wgNcVsckvG2UievifHNggG8hZbjlS15PBdhXhvR_68=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmS5XvYFnM4nm2fscKM9g2FW1RBKGGQ9iRjyxiavaSnEfr"}, "content-type": "image/png", "sha256": "V7Mk8pat5K0iWJzcYwFoUTweqIDzq8yp2j0F6xCHCmk=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmNRJ7owchNZxBgz7SDcUubfGE3QSf5nh3FoUvgtTz7ers"}, "content-type": "image/png", "height": 350, "sha256": "ZH-FcMeVftC3sRYaIu1drh4LzVSIKNdw-91p43Xu5Tw=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmQX9KTiNi53F9N6dA5uhciejabLc7FcG1pon3ZrRvNuuk"}, "content-type": "image/png", "height": 500, "sha256": "2wgNcVsckvG2UievifHNggG8hZbjlS15PBdhXhvR_68=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/8523/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmV9AiMcrQq8LRBj7REh9JsopcqNMBj4cD92MrhfYXYEBS"}, "content-type": "image/png", "sha256": "kziAuWmPgHD10rHs3iBA_Dbh