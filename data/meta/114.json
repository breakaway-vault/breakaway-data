. All Rights Reserved. [Terms Apply](https://nhlbreakaway.com/terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmW1bRmQ6M41inS1mLv2a4woM43kgYqGGEuQooN5gDLTZj"}, "content-type": "image/png", "sha256": "ErhyGC-MdMcxL390vKvFBWOL4dzsNacVzy1k3rL2SRI=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmWLRqYmZzY84Ymu9GR5RS6VE7epRi2wLN3UYxZT6Qoqs8"}, "content-type": "image/png", "height": 350, "sha256": "5jvVcx9q_54NFb0SEnhisdnmdGy9XAK1FH4cENZ2-HU=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmTmvxW5sq1YwSU7p6Ar283vqTKeQcgjKMGdvTK3Rd3vL5"}, "content-type": "image/png", "height": 500, "sha256": "L4S2v6PLOxDjS3Zel5u8iGHqDSwwfgbIb7HN2woQFOY=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmW1bRmQ6M41inS1mLv2a4woM43kgYqGGEuQooN5gDLTZj"}, "content-type": "image/png", "sha256": "ErhyGC-MdMcxL390vKvFBWOL4dzsNacVzy1k3rL2SRI=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmWLRqYmZzY84Ymu9GR5RS6VE7epRi2wLN3UYxZT6Qoqs8"}, "content-type": "image/png", "height": 350, "sha256": "5jvVcx9q_54NFb0SEnhisdnmdGy9XAK1FH4cENZ2-HU=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmTmvxW5sq1YwSU7p6Ar283vqTKeQcgjKMGdvTK3Rd3vL5"}, "content-type": "image/png", "height": 500, "sha256": "L4S2v6PLOxDjS3Zel5u8iGHqDSwwfgbIb7HN2woQFOY=", "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M8R5DJbD/a4a2/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmdgYKate4ZmZ4jLhZEMLpTgvmbar2HsnYyzg9Z7kZoZPN"}, "content-t