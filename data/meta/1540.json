away.com/terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmPdQ5ft17tixhacJ2rWQiZtkrJpSrR68FQuNia2Hkfpgd"}, "content-type": "image/png", "sha256": "B4mDx7C0jOk2ChrVehJnXRoZ262K3zVwuCMkbRwAUx4=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmNTPhhYST1NsSeuq5mX1bReZWLuZWf8zAsqUVuQ7gPA68"}, "content-type": "image/png", "height": 350, "sha256": "Ji-02wv2d8qBNub8Xtq0yZuAfTdcURuXDblILfiWqKs=", "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmeJr6eDG13Kf9bnnVgDikGwNBpxFKmw45hEEuaAu6pL6t"}, "content-type": "image/png", "height": 500, "sha256": "IPlWqLnJMM72hWbnwWrRDaNM6WZV5nCqNzmXwDthHJ4=", "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmPdQ5ft17tixhacJ2rWQiZtkrJpSrR68FQuNia2Hkfpgd"}, "content-type": "image/png", "sha256": "B4mDx7C0jOk2ChrVehJnXRoZ262K3zVwuCMkbRwAUx4=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmNTPhhYST1NsSeuq5mX1bReZWLuZWf8zAsqUVuQ7gPA68"}, "content-type": "image/png", "height": 350, "sha256": "Ji-02wv2d8qBNub8Xtq0yZuAfTdcURuXDblILfiWqKs=", "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmeJr6eDG13Kf9bnnVgDikGwNBpxFKmw45hEEuaAu6pL6t"}, "content-type": "image/png", "height": 500, "sha256": "IPlWqLnJMM72hWbnwWrRDaNM6WZV5nCqNzmXwDthHJ4=", "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/VqmoD3bg/9b8a/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmU13XJnM4TEDCQJWhHfwzguCxhBQAqdwtNttrD9uVxHuE"}, "content-type": "image/png", "sha256": "ibX1gN70nlWgAGbxiP8awJc