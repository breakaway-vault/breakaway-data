BeNYN2V5O2aRyUiuUj_E974rtnvk7JZxNT264syDZI=", "uri": "https://mediagateway.sweet.io/media/token/r1JoLvbv/12901968507486339072/poster-image-square.png"}], "reverse_image": null}, "attributes": [{"name": "Audio Type", "value": "Sounds of the Game"}, {"name": "Crafted from Editions", "value": "70,78,85"}, {"name": "Crafted from Rarity", "value": "Epic"}, {"name": "Date", "value": "2015-06-15"}, {"name": "Edition Number", "value": "1"}, {"name": "Moment UUID", "value": "cd2f47fe3c0b0000b30d000000000000"}, {"name": "Play", "value": "Goal"}, {"name": "Player", "value": "Patrick Kane"}, {"name": "Rarity", "value": "Heroic"}, {"name": "Series", "value": "Series 2"}, {"name": "Series UUID", "value": "cd2f47fe000000000000000000000000"}, {"name": "Set", "value": "Signature Epics"}, {"name": "Set UUID", "value": "cd2f47fe3c0b00000000000000000000"}, {"name": "Team", "value": "Chicago Blackhawks"}], "creator": {"name": "SocialSweet Inc.", "uri": "https://sweet.io"}, "description": "Between 2010 and 2019, Patrick Kane scored more playoff points than any player except Sidney Crosby. During that time, the Chicago Blackhawks captured three Stanley Cup championships, more than any other team. Kane produced numerous highlights throughout this dominant era, including a pivotal moment in Game 6 of the 2015 Stanley Cup Final against the Tampa Bay Lightning. With the Blackhawks up 1-0 and just over five minutes remaining in the third period, a missed Lightning shot led to a rush up the ice by Brandon Saad. After crossing the blue line, Saad dropped the puck to Brad Richards, who skated in and found Kane on the far side. Kane one-timed the puck into the net, sealing the Blackhawks' third championship in six seasons and sending the home crowd into a frenzy. Kane finished the 2015 playoffs tied for the lead in points with 23.\r\n\r\nOfficially Licensed Product of the NHL, NHLPA, and/or NHLAA. All copyright, logos, and marks are the property of their respective owners and are used, under licen