terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmRUh8kLrFTjzz1r6KA7GAmyRv44VE1kzvhtQQUfdJW7NM"}, "content-type": "image/png", "sha256": "BRI9JBjYzog94d4kBgCxv-KkuJTF2ZEzfQaJF1bkuwU=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmSHqiiTG9xL7Uty8XYqVJFYM8ZP8vq1kDwaNkMXZK1wmb"}, "content-type": "image/png", "height": 350, "sha256": "YHa-vuGQ3ObGnoVZrpbmPOsVoaimFZGWWbtklIMmxLo=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmXBKPj32jCdADExhciPLaYWPVWJR7MANjsaCuruBokXbE"}, "content-type": "image/png", "height": 500, "sha256": "8Ns09xGxHmntEg_2vi7zxqpm8S8DReUQY_k3xyKQ06U=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmRUh8kLrFTjzz1r6KA7GAmyRv44VE1kzvhtQQUfdJW7NM"}, "content-type": "image/png", "sha256": "BRI9JBjYzog94d4kBgCxv-KkuJTF2ZEzfQaJF1bkuwU=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmSHqiiTG9xL7Uty8XYqVJFYM8ZP8vq1kDwaNkMXZK1wmb"}, "content-type": "image/png", "height": 350, "sha256": "YHa-vuGQ3ObGnoVZrpbmPOsVoaimFZGWWbtklIMmxLo=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmXBKPj32jCdADExhciPLaYWPVWJR7MANjsaCuruBokXbE"}, "content-type": "image/png", "height": 500, "sha256": "8Ns09xGxHmntEg_2vi7zxqpm8S8DReUQY_k3xyKQ06U=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/9f1a/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmUnFZHyzf4h8Rfym7voZyrKY8ZujYPemCKrjfNipxFjTF"}, "content-type": "image/png", "sha256": "YL69JWYTkkwt7NKpFU4MUJQs6zh6c6ct