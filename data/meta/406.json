breakaway.com/terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmPW54CbieH3QkauNDLnjXaXLFDqw7yXc2E2ewSyhGdfLj"}, "content-type": "image/png", "sha256": "lZTXXqjnmYQL9ebJfPW0GznKvHC4jYTQg9JpZtH8Jt0=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmPR123Ps4RA9HxmeAeDZM1hcXqkJUzgWzyPnF7BBPCm8V"}, "content-type": "image/png", "height": 350, "sha256": "21aP7oas3eEJxs66WyeaMokAcvezu0jzA57hAPj5jGk=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmQP443vw2SuokNhUeAhDzDfe1JWk68dKG1dBjS19MFDVQ"}, "content-type": "image/png", "height": 500, "sha256": "X1Bbj2i-oUQ3vtMunAPp1nf1jzynqRyJnu2lzTM4f-c=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmPW54CbieH3QkauNDLnjXaXLFDqw7yXc2E2ewSyhGdfLj"}, "content-type": "image/png", "sha256": "lZTXXqjnmYQL9ebJfPW0GznKvHC4jYTQg9JpZtH8Jt0=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmPR123Ps4RA9HxmeAeDZM1hcXqkJUzgWzyPnF7BBPCm8V"}, "content-type": "image/png", "height": 350, "sha256": "21aP7oas3eEJxs66WyeaMokAcvezu0jzA57hAPj5jGk=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmQP443vw2SuokNhUeAhDzDfe1JWk68dKG1dBjS19MFDVQ"}, "content-type": "image/png", "height": 500, "sha256": "X1Bbj2i-oUQ3vtMunAPp1nf1jzynqRyJnu2lzTM4f-c=", "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/M1AOOVRz/8afd/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmeEQoNmUuv3pCLLDfZnnK47eL3wEsdfMQbmccsUYzoNc2"}, "content-type": "image/png", "sha256": "0auY_1cJy92HZauLI0