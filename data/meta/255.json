.com/terms).", "edition_number": "1", "fees": [{"basis_points": 600, "recipient_address": "0x2B184E8f31a060bB91e118487824497F63F34A12", "type": "seller-fee"}], "image": {"altloc": {"ipfs": "ipfs://QmNRbuKgy4ydsNHz8Ri3wanXpyVgfUZaSDGNZDS2iVVGF1"}, "content-type": "image/png", "sha256": "sAQVvkQ5kf_eXpKlhFBIZlrKlGOGBMv5I0i68eKKSmc=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmdT65YnC1HRWbQo21TLmFC8RmpzC2YqkbS1UnGo2V7ax8"}, "content-type": "image/png", "height": 350, "sha256": "rxJnwgNA8lEGu7-IwH9T1TOTh4toChIrERdJ_xc6PTI=", "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmZtVuUqRfP3PVN5NQ7udGZ77qYXiEECjHKrD45965dsb5"}, "content-type": "image/png", "height": 500, "sha256": "RemnQVwr3iQvBRx5KekcjCJBNnuk5atR7rsg1Z7A0M0=", "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front.png"}, "images": {"front": {"altloc": {"ipfs": "ipfs://QmNRbuKgy4ydsNHz8Ri3wanXpyVgfUZaSDGNZDS2iVVGF1"}, "content-type": "image/png", "sha256": "sAQVvkQ5kf_eXpKlhFBIZlrKlGOGBMv5I0i68eKKSmc=", "thumbnail": {"350": {"altloc": {"ipfs": "ipfs://QmdT65YnC1HRWbQo21TLmFC8RmpzC2YqkbS1UnGo2V7ax8"}, "content-type": "image/png", "height": 350, "sha256": "rxJnwgNA8lEGu7-IwH9T1TOTh4toChIrERdJ_xc6PTI=", "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front-350x.png", "width": 350}, "500": {"altloc": {"ipfs": "ipfs://QmZtVuUqRfP3PVN5NQ7udGZ77qYXiEECjHKrD45965dsb5"}, "content-type": "image/png", "height": 500, "sha256": "RemnQVwr3iQvBRx5KekcjCJBNnuk5atR7rsg1Z7A0M0=", "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front-500x.png", "width": 500}}, "url": "https://nft.nhlbreakaway.com/series/XRe24Wqk/b47e/images/front.png"}, "front-16x9": {"altloc": {"ipfs": "ipfs://QmXUwPQir139GmZfM3bhSHgNuQduAg4UERrH2dhveQsW9h"}, "content-type": "image/png", "sha256": "2DMuDTd4iDE7nWjuOKFP33-H366